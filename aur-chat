#!/usr/bin/env python3
import os
import sys
from pathlib import Path

# Before aur_chat imports (desktop entries often lack XDG_RUNTIME_DIR).
_rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
if os.path.isdir(_rt):
    os.environ.setdefault("XDG_RUNTIME_DIR", _rt)
    _bus = f"unix:path={_rt}/bus"
    if os.path.exists(f"{_rt}/bus"):
        os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS", _bus)


def _package_root() -> Path:
    env = os.environ.get("AUR_CHAT_ROOT")
    if env:
        return Path(env).resolve()
    here = Path(__file__).resolve().parent
    for root in (here, here.parent, Path.home() / ".local" / "share" / "aur-chat"):
        if (root / "aur_chat" / "gui.py").is_file():
            return root
    raise SystemExit(
        "aur-chat: package not found. Re-run install-desktop.sh from the repo, "
        "or set AUR_CHAT_ROOT to the aur-chat project directory."
    )


sys.path.insert(0, str(_package_root()))
from aur_chat.gui import main

if __name__ == "__main__":
    main()
